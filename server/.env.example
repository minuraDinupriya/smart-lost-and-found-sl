PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/usjp_smart_lost_found
# Generate a unique random secret of at least 32 characters; startup requires it.
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Production: set CLIENT_URL to your exact frontend origin(s), comma-separated.

# Required only by scripts/seedPolice.js; choose a unique password locally.
SEED_POLICE_PASSWORD=

# Public OAuth client ID; use the same value as VITE_GOOGLE_CLIENT_ID in the client.
GOOGLE_CLIENT_ID=

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Smart Item Identification AI Vision Provider
ITEM_IDENTIFICATION_API_KEY=your_ai_vision_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
